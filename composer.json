{
  "name": "achttienvijftien/wp-memcached",
  "description": "The real Memcached (not Memcache) backend for the WP Object Cache",
  "type": "library",
  "keywords": [
    "wordpress",
    "plugin",
    "memcached",
    "memcache"
  ],
  "homepage": "https://www.1815.nl",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "1815",
      "email": "it@1815.nl",
      "homepage": "https://www.1815.nl"
    }
  ],
  "require": {
    "php": "^8.0",
    "composer/installers": "^1.8 || ^2.0",
    "koodimonni/composer-dropin-installer": "^1.4"
  },
  "require-dev": {
    "achttienvijftien/building-techniques": "^1.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^0.7.2",
    "phpcompatibility/phpcompatibility-wp": "*",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^9.6",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "yoast/phpunit-polyfills": "^1.1"
  },
  "scripts": {
    "format": "phpcbf --report-summary --report-source",
    "lint": "phpcs",
    "test": "phpunit",
    "analyse": "phpstan analyse"
  },
  "minimum-stability": "stable",
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "koodimonni/composer-dropin-installer": true,
      "composer/installers": true
    },
    "sort-packages": true,
    "platform": {
      "php": "8.0"
    }
  }
}
